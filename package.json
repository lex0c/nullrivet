{
  "name": "nullrivet",
  "version": "0.0.0",
  "private": true,
  "description": "Ephemeral AI agent for the terminal",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "nullrivet": "src/main.ts"
  },
  "scripts": {
    "start": "bun --no-env-file --env-file=.env src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "engines": {
    "bun": ">=1.1.30"
  },
  "dependencies": {
    "openai": "~6.34.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "~1.3.14",
    "@types/mdast": "^4.0.4",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
